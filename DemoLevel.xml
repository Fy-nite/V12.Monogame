<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo scene authored the way the V12 3D editor would export it (WorldML).
  bootstrap.cs loads this, merges it into the active world, and binds C# handlers
  to the named/tagged elements below.
-->
<World name="DemoLevel">

  <!-- Bound by name: "DemoButton" -->
  <Element name="DemoButton">
    <TransformComponent x="0" y="1.0" z="-3" />
    <Component type="MeshComponent" name="demo_button_mesh" Shape="Box" Width="0.6" Height="0.6" Depth="0.6" />
    <Component type="MeshRenderer" Mesh="demo_button_mesh" />
    <ColliderComponent Shape="Box" Width="0.6" Height="0.6" Depth="0.6" />
    <ButtonComponent Label="Bound Button" />
    <TagComponent Tags="demo,interactive" />
  </Element>

  <!-- Bound by tag ("enemy") and by path ("DemoEnemies/Enemy_A") -->
  <Element name="DemoEnemies">
    <TransformComponent x="8" y="0" z="0" />
    <Element name="Enemy_A">
      <TransformComponent x="8" y="0.5" z="0" />
      <Component type="MeshComponent" name="enemy_a_mesh" Shape="Box" Width="1" Height="1" Depth="1" />
      <Component type="MeshRenderer" Mesh="enemy_a_mesh" />
      <ColliderComponent Shape="Box" Width="1" Height="1" Depth="1" />
      <PhysicsBodyComponent IsKinematic="false" />
      <TagComponent Tags="demo,enemy" />
    </Element>
    <Element name="Enemy_B">
      <TransformComponent x="10" y="0.5" z="0" />
      <Component type="MeshComponent" name="enemy_b_mesh" Shape="Box" Width="1" Height="1" Depth="1" />
      <Component type="MeshRenderer" Mesh="enemy_b_mesh" />
      <ColliderComponent Shape="Box" Width="1" Height="1" Depth="1" />
      <PhysicsBodyComponent IsKinematic="false" />
      <TagComponent Tags="demo,enemy" />
    </Element>
  </Element>

</World>
